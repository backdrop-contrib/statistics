<?php

/**
 * @file
 * Logs and displays access statistics for a site.
 */

require_once __DIR__ . '/statistics.record.inc';

/**
 * Implements hook_exit().
 *
 * Records the visit when visits are recorded on the server. In browser mode
 * statistics.php records it instead, so that pages served from the page cache
 * are counted too.
 */
function statistics_exit() {
  // With $settings['page_cache_invoke_hooks'] enabled, hook_exit() also runs
  // on page cache hits, before common.inc and menu.inc are loaded. Do not call
  // backdrop_bootstrap() here: it would consume the bootstrap phases of the
  // request still in progress.
  if (backdrop_get_bootstrap_phase() < BACKDROP_BOOTSTRAP_FULL) {
    return;
  }
  $config = config('statistics.settings');
  if (statistics_record_method() != 'server' || !($config->get('count_content_views') || $config->get('enable_access_log'))) {
    return;
  }
  // Excluded roles are neither logged nor counted.
  if (statistics_node_count_excluded_role()) {
    return;
  }

  $visit = statistics_current_visit();
  $visit['referrer'] = isset($_SERVER['HTTP_REFERER']) ? $_SERVER['HTTP_REFERER'] : '';
  $visit['timer'] = (int) timer_read('page');
  statistics_record_visit($visit);
}

/**
 * Returns how visits are recorded: 'browser' or 'server'.
 *
 * @return string
 *   'browser' when the page's JavaScript reports each visit to
 *   statistics.php, which counts pages served from the page cache; 'server'
 *   when statistics_exit() records it while building the page.
 */
function statistics_record_method() {
  return config_get('statistics.settings', 'record_method') == 'server' ? 'server' : 'browser';
}

/**
 * Describes the page being built, for recording as a visit.
 *
 * @return array
 *   The path, title and, on a node's own page, nid and node_type, in the form
 *   statistics_record_visit() takes.
 */
function statistics_current_visit() {
  $visit = array(
    'path' => current_path(),
    'title' => (string) backdrop_get_title(),
    'nid' => 0,
  );
  // Only the node's own page is a view: node/1/edit and node/1/revisions load
  // the same node but must not be counted.
  $node = menu_get_object('node');
  if ($node && !empty($node->nid) && $visit['path'] == 'node/' . $node->nid) {
    $visit['nid'] = $node->nid;
    $visit['node_type'] = $node->type;
  }
  return $visit;
}

/**
 * Implements hook_preprocess_page().
 *
 * In browser mode, adds the script that reports this visit. It becomes part
 * of the cached page, so every visitor served from the page cache reports
 * their own visit.
 */
function statistics_preprocess_page(&$variables) {
  $config = config('statistics.settings');
  if (statistics_record_method() != 'browser' || !($config->get('count_content_views') || $config->get('enable_access_log'))) {
    return;
  }
  // Only logged-in users can be excluded, and their pages are never cached, so
  // skipping the script here is safe. statistics.php checks again.
  if (statistics_node_count_excluded_role()) {
    return;
  }
  $visit = statistics_current_visit();
  unset($visit['node_type']);
  backdrop_add_js(array('statistics' => array(
    'url' => url(backdrop_get_path('module', 'statistics') . '/statistics.php', array('absolute' => TRUE)),
    'data' => $visit,
  )), 'setting');
  backdrop_add_js(backdrop_get_path('module', 'statistics') . '/statistics.js', array('scope' => 'footer'));
}

/**
 * Implements hook_permission().
 */
function statistics_permission() {
  return array(
    'administer statistics' => array(
      'title' => t('Administer statistics'),
    ),
    'access statistics' => array(
      'title' => t('View content access statistics'),
    ),
    'view post access counter' => array(
      'title' => t('View content hits'),
    ),
  );
}

/**
 * Implements hook_node_view().
 */
function statistics_node_view($node, $view_mode) {
  if ($view_mode != 'rss') {
    if (user_access('view post access counter')) {
      $statistics = statistics_get($node->nid);
      if ($statistics) {
        $links['statistics_counter']['title'] = format_plural($statistics['totalcount'], '1 read', '@count reads');
        $node->content['links']['statistics'] = array(
          '#theme' => 'links__node__statistics',
          '#links' => $links,
          '#attributes' => array('class' => array('links', 'inline')),
        );
      }
    }
  }
}

